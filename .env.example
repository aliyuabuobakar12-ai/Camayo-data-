# Copy to .env for local development. Never upload .env to GitHub.
PORT=3000
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
APP_URL=http://localhost:3000
DB_PATH=./camayo.db

# Paystack test/live secret key. Keep private.
PAYSTACK_SECRET_KEY=

# VTpass credentials
VTPASS_BASE_URL=https://vtpass.com/api
